# Copy to .env (server/.env). Never commit real keys.
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/layquest

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# AI (itinerary planner). Pick the model in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=

# Weather and danger
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GDACS_BASE_URL=

# Social embeds
TIKTOK_OEMBED_URL=https://www.tiktok.com/oembed

# Places, visa, tickets (check access terms for each before building on them)
STB_API_KEY=
TRAVEL_BUDDY_API_KEY=
TRIPCOM_API_KEY=
